# ───────── Copy to .env (never commit .env). Generate secrets with: openssl rand -base64 48 ─────────
DATABASE_URL=postgresql://techmunda:techmunda_dev@localhost:5432/jewellery_studio?schema=public
POSTGRES_PASSWORD=techmunda_dev
REDIS_URL=redis://localhost:6379
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Secrets — all required, min 32 chars (ENCRYPTION_KEY = base64 of 32 random bytes: openssl rand -base64 32)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ENCRYPTION_KEY=
URL_SIGNING_SECRET=
AUTOMATION_WEBHOOK_SECRET=

# Storage: local (dev, no services needed) or s3 (MinIO / AWS S3 / R2)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage-data
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=jewellery-studio
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# AI. auto = live when OPENAI_API_KEY is set, otherwise clearly-labelled simulation. openai = fail loudly if key missing. simulated = never call out.
AI_MODE=auto
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1

# Gmail OAuth (Google Cloud → OAuth client, type "Web", redirect URI below). Without these, Gmail send is BLOCKED (by design).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/integrations/google/callback
GMAIL_DESIRED_SENDER=techmunda21@gmail.com

# Optional bot protection for the public enquiry form (Cloudflare Turnstile secret). Honeypot + timing trap + rate limit are always on.
TURNSTILE_SECRET=

QUEUE_MODE=redis
LOG_LEVEL=info
DEMO_PASSWORD=Demo@12345

# n8n (docker compose --profile automation up)
N8N_TENANT_ID=
N8N_TENANT_WEBHOOK_SECRET=
N8N_INBOUND_WEBHOOK_SECRET=

# ───────── Self-service signup (OTP verification) ─────────
# At least one delivery channel is required, otherwise the signup page says it is unavailable (no fake codes).
# E-mail via SMTP — Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=techmunda21@gmail.com, SMTP_PASS=<16-char Google App Password>
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Techmunda <techmunda21@gmail.com>
# Mobile SMS via Twilio (India needs a DLT-registered sender/template; use a Messaging Service)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
SIGNUP_ENABLED=true
DEMO_RETENTION_DAYS=30
# LOCAL DEVELOPMENT ONLY — prints OTPs in the API log. Refused when NODE_ENV=production or on Render/Railway/Vercel.
ALLOW_INSECURE_OTP_CONSOLE=false
