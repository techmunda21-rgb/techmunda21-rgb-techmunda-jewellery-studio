{
  "name": "@techmunda/database",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed": "tsx seed.ts",
    "seed:if-needed": "tsx seed.ts --if-needed",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@techmunda/core": "workspace:*",
    "@techmunda/shared": "workspace:*",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.8",
    "sharp": "^0.34.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prisma": "6.19.3",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
